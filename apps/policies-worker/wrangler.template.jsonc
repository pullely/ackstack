// Rendered to wrangler.jsonc by tooling/wire/render.mjs (BF6 deploy-time wiring).
// Resource IDs are NEVER committed: @@wiring(<component>/<env>:<key>)@@ tokens are
// resolved from the workspace's orun secrets at deploy time (wire-live) or from the
// committed wiring.fixture.json for offline dry-runs (wire-fixture).
{
  "name": "ackstack-policies-worker",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  "minify": false,
  // AS2: every ten minutes, send what a round left unsent.
  // AS3: nightly at 06:15 UTC, open the due re-collection rounds.
  "triggers": {
    "crons": ["*/10 * * * *", "15 6 * * *"]
  },
  "vars": {
    "ENVIRONMENT": "local"
  },
  "env": {
    "dev": {
      "vars": {
        "ENVIRONMENT": "dev"
      }
    },
    "stage": {
      "workers_dev": false,
      "vars": {
        "ENVIRONMENT": "stage",
        // AS2: the emailed link opens the console's public /ack/<token> page.
        "ACK_LINK_BASE_URL": "https://ackstack-web-console-next-stage.nexo-7be.workers.dev",
        // The baseline's inline-delivery profile (identity-worker returns login
        // codes inline under the same flag): created links are also returned
        // to the admin who sent them.
        "DEBUG_DELIVERY": "true"
      },
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "ackstack-stage",
          "database_id": "@@wiring(cloudflare-d1/stage:d1_database_id)@@"
        }
      ],
      // AS1: policy documents. Bound by name — cloudflare-r2 names the bucket
      // deterministically as <namespacePrefix>ackstack-policy-docs-<env>, and
      // the runner injects namespacePrefix per environment ("stg-" / "prod-").
      "r2_buckets": [
        {
          "binding": "POLICY_DOCS",
          "bucket_name": "stg-ackstack-policy-docs-stage"
        }
      ],
      "services": [
        {
          "binding": "MEMBERSHIP_WORKER",
          "service": "ackstack-membership-worker-stage"
        },
        {
          "binding": "POLICY_WORKER",
          "service": "ackstack-policy-worker-stage"
        },
        {
          "binding": "NOTIFICATIONS_WORKER",
          "service": "ackstack-notifications-worker-stage"
        }
      ]
    },
    "prod": {
      "workers_dev": false,
      "vars": {
        "ENVIRONMENT": "prod",
        // AS2: the emailed link opens the console's public /ack/<token> page.
        "ACK_LINK_BASE_URL": "https://ackstack-web-console-next-prod.nexo-7be.workers.dev",
        // Production matches identity-worker and membership-worker: no inline
        // delivery. Links reach staff only by email.
        "DEBUG_DELIVERY": "false"
      },
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "ackstack-prod",
          "database_id": "@@wiring(cloudflare-d1/prod:d1_database_id)@@"
        }
      ],
      // AS1: policy documents. Bound by name — cloudflare-r2 names the bucket
      // deterministically as <namespacePrefix>ackstack-policy-docs-<env>, and
      // the runner injects namespacePrefix per environment ("stg-" / "prod-").
      "r2_buckets": [
        {
          "binding": "POLICY_DOCS",
          "bucket_name": "prod-ackstack-policy-docs-prod"
        }
      ],
      "services": [
        {
          "binding": "MEMBERSHIP_WORKER",
          "service": "ackstack-membership-worker-prod"
        },
        {
          "binding": "POLICY_WORKER",
          "service": "ackstack-policy-worker-prod"
        },
        {
          "binding": "NOTIFICATIONS_WORKER",
          "service": "ackstack-notifications-worker-prod"
        }
      ]
    }
  }
}
